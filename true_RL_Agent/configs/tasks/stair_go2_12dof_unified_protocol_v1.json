    "failure_priority": [
      "forbidden_contact",
      "fall",
      "off_course",
      "base_orientation_instability",
      "slip",
      "insufficient_clearance",
      "timeout"
    ],
    "primary_reasons": [
      "success",
      "forbidden_contact",
      "fall",
      "off_course",
      "base_orientation_instability",
      "slip",
      "insufficient_clearance",
      "timeout"
    ],
    "signals": {
      "base_orientation_instability": {
        "comparison": "greater_than",
        "consecutive_control_steps": 10,
        "source": "kinematic_base_roll_or_pitch_abs",
        "threshold": 0.65,
        "unit": "rad"
      },
      "fall": {
        "comparison": "less_than",
        "consecutive_control_steps": 5,
        "maximum_projected_surface_penetration_m": 0.018,
        "no_contact_fallback": "lowest_vertically_feasible_projected_support_surface",
        "source": "kinematic_base_height_above_lowest_vertically_feasible_contacting_support_surface",
        "threshold": 0.265,
        "unit": "m"
      },
      "forbidden_contact": {
        "force_threshold_n": 1.0,
        "manager_term": "base_contact",
        "other_body_contacts_policy": "allowed_unless_another_failure_signal_triggers",
        "source": "resolved_forbidden_contact_role_force",
        "trigger": "manager_term_active"
      },
      "insufficient_clearance": {
        "comparison": "less_than",
        "consecutive_control_steps": 3,
        "source": "noncontact_support_effector_clearance_above_projected_local_stair_surface",
        "threshold": 0.018,
        "unit": "m"
      },
      "off_course": {
        "comparison": "outside",
        "consecutive_control_steps": 1,
        "source": "kinematic_base_xy_outside_own_terrain_patch",
        "unit": "m"
      },
      "slip": {
        "consecutive_control_steps": 5,
        "contact_force_threshold": 1.0,
        "force_unit": "N",
        "source": "support_effector_planar_speed_while_in_contact",
        "speed_threshold": 0.5,
        "speed_unit": "m/s"
      },
      "timeout": {
        "deadline_authority": "ordered_evaluation_suite",
        "source": "evaluation_suite_cell_episode_horizon",
        "unit": "s"
      }
    },
    "success": {
      "completion_mode": "stable_top_traversal_after_first_valid_top_arrival",
      "minimum_progress_fraction": 1.0,
      "minimum_support_effector_upward_force_n": 10.0,
      "minimum_support_effectors_on_top": 1,
      "post_arrival_failure_policy": "blocks_success_until_stability_requirement_met",
      "pre_arrival_blocking_latches": [
        "forbidden_contact",
        "fall",
        "off_course"
