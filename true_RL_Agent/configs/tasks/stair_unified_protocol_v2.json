      "base_orientation_instability",
      "slip",
      "insufficient_clearance",
      "timeout"
    ],
    "signals": {
      "base_orientation_instability": {
        "comparison": "greater_than",
        "consecutive_control_steps": 10,
        "source": "kinematic_base_roll_or_pitch_abs",
