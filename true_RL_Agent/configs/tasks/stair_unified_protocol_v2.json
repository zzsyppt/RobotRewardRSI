        "threshold": 0.03,
        "unit": "m"
      },
      "off_course": {
        "comparison": "outside",
        "consecutive_control_steps": 1,
        "source": "kinematic_base_xy_outside_own_terrain_patch",
        "unit": "m"
      },
      "slip": {
        "consecutive_control_steps": 5,
        "contact_force_threshold": 1.0,
        "force_unit": "N",
        "source": "support_effector_planar_speed_while_in_contact",
        "speed_threshold": 0.5,
        "speed_unit": "m/s"
      },
      "timeout": {
        "deadline_authority": "ordered_evaluation_suite",
        "source": "evaluation_suite_cell_episode_horizon",
        "unit": "s"
      }
    },
    "support_surface_projection": {
      "maximum_projected_surface_penetration_m": 0.03,
      "no_contact_fallback": "lowest_vertically_feasible_projected_support_surface"
    },
    "success": {
