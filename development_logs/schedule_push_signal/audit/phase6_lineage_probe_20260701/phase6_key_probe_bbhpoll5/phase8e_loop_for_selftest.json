{
  "acceptance": {
    "absolute_accept_success_floor": 0.05,
    "absolute_dev_min_passing_runs": 2,
    "absolute_dev_seed_floor": 0.03,
    "near_zero_success_threshold": 0.02,
    "no_accept_without_public_accept": true,
    "notes": [
      "public_dev floor can mark a candidate promising, but cannot accept it",
      "public_accept plus required gates is needed before recipe inheritance",
      "ood_stress_gate is emitted as diagnostic/not_run in Phase 8E-6-1 and becomes required only after a real OOD distribution and thresholds are implemented"
    ],
    "public_min_delta": 0.05,
    "required_pass_gates": [
      "budget_accounting",
      "motion_quality_gate"
    ]
  },
  "candidate_capabilities": {
    "allowed": [
      "RewardTerm callables over public RewardInputs",
      "LossTerm callables over public RewardInputs",
      "ScheduleTerm callables pre-evaluated on public progress points",
      "training-only domain randomization schedules through runner-whitelisted keys",
      "DiagnosticTerm callables over public RewardInputs returning numeric public summaries"
    ],
    "forbidden": [
      "runner hook",
      "PPO loop hook",
      "optimizer hook",
      "env-step dispatcher",
      "checkpoint selector",
      "eval observation wrapper",
      "eval action wrapper",
      "success metric",
      "budget or seed changes",
      "network/filesystem/process control"
    ]
  },
  "full_round": {
    "public_rollout": {
      "accept_seeds": [
        2101,
        2102,
        2103
      ],
