        1103
      ],
      "max_steps": 200,
      "num_envs": 64,
      "policy": "checkpoint",
      "profile": "phase2_public",
      "script": "scripts/phase1_push_recovery_eval.py",
      "seed_visibility": "runner_owned_raw_rollout_only; public_result projects to run_index and aggregate success metrics before LLM feedback.",
