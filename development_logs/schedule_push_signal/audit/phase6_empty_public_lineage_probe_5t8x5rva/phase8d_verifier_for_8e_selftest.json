{
  "dynamic": {
    "allow_llm_authored_in_isolated_verifier": true,
    "fast_validation": {
      "enabled": true,
      "num_actions": 29,
      "num_envs": 4,
      "num_joints": 29,
      "prefer_torch": true,
      "progress_points": [
        0.0,
        0.5,
        1.0
      ]
    },
    "require_noop_components": false,
    "require_phase8c_isolation": false,
    "scan_public_component_summary": true
  },
  "notes": {
    "non_goals": [
      "full reward callable execution in PPO loop",
      "optimizer/gradient runtime hook accounting",
      "eval observation/action wrapper execution"
    ],
    "scope": "Phase8D verifies candidate package and isolated component loading. It does not run full Isaac/RSL-RL training."
  },
  "phase": "8D-code-verifier",
  "phase8c_isolation_config": "configs/cold_start/phase8c_isolation.yaml",
  "schema_version": "humanoid_agent.phase8d.verifier.config.v1",
  "static": {
    "allowed_file_suffixes": [
      ".py",
      ".yaml",
      ".yml",
      ".json",
      ".md",
      ".txt"
    ],
    "allowed_top_level_entries": [
      "candidate_manifest.yaml",
      "training_code",
      "rationale.md",
      "operation_diff.json",
      "diagnostics.json"
    ],
    "forbidden_call_names": [
      "eval",
      "exec",
      "compile",
      "open",
      "__import__",
      "input",
      "breakpoint",
      "getattr",
      "setattr",
      "globals",
      "locals",
      "vars",
      "dir"
    ],
    "forbidden_import_roots": [
      "base64",
      "builtins",
      "ctypes",
      "ftplib",
      "glob",
      "http",
      "importlib",
      "multiprocessing",
      "os",
      "pathlib",
      "pickle",
      "requests",
      "shutil",
      "socket",
      "subprocess",
      "threading",
      "urllib"
    ],
    "forbidden_manifest_capabilities": [
      "runner_hook",
      "ppo_loop_hook",
      "env_step_dispatcher",
      "optimizer_hook",
      "checkpoint_selector",
      "eval_wrapper",
      "success_classifier",
      "process_control",
      "network",
      "filesystem",
      "secrets",
      "hidden_eval"
    ],
    "forbidden_numeric_tokens": [
      1001,
      2001
    ],
    "forbidden_path_parts": [
      ".git",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache"
    ],
    "forbidden_string_tokens": [
      "iid_hidden",
      "iid-hidden",
      "phase2_iid_hidden",
      "iid_hidden_eval",
      "iid_hidden_success_rate",
      "hidden_audit",
      "hidden_eval",
      "accept_reject",
      "DEEPSEEK_API_KEY",
      "OPENAI_API_KEY",
      "api_key",
      "secret"
    ],
    "max_file_bytes": 262144,
    "max_files": 64,
    "max_total_bytes": 1048576
  },
  "summary_schema_version": "humanoid_agent.phase8d.verifier.summary.v1"
}